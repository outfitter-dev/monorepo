{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@outfitter next app",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "incremental": true,
    "declaration": false,
    "plugins": [{ "name": "next" }]
  }
}
